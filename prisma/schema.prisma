// Prisma schema for the CBT (Computer-Based Testing) system
// Phase 1: Foundation — core models for users, questions, exams, and attempts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTI_SELECT
  TRUE_FALSE
  FILL_BLANK
  MATCHING
  ORDERING
  ESSAY
  SHORT_ANSWER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  TIMED_OUT
}

// ---------- Models ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(STUDENT)
  
  // Academic Profiles
  studentId    String?  // Matric Number
  instructorId String? // Staff ID
  departmentId String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attempts         Attempt[]
  exams            Exam[]    @relation("ExamAuthor")
  authoredQuestions Question[]
  enrollments      Enrollment[]
  department       Department? @relation(fields: [departmentId], references: [id])

  @@map("user")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  questions QuestionTag[]

  @@map("tag")
}

model QuestionTag {
  id         String   @id @default(cuid())
  questionId String
  tagId      String
  assignedAt DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id])
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@unique([questionId, tagId])
  @@index([tagId])

  @@map("question_tag")
}

model Question {
  id          String       @id @default(cuid())
  type        QuestionType
  prompt      String
  // JSON payload: options, correct answer(s), matching pairs, ordering, etc.
  data        Json
  explanation String?
  difficulty  Difficulty   @default(MEDIUM)
  points      Int          @default(1)
  timeEstimateSec Int?     // estimated seconds to answer
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy User       @relation(fields: [createdById], references: [id])
  tags      QuestionTag[]
  examItems ExamQuestion[]
  answers   AttemptAnswer[]

  @@index([createdById])

  @@map("question")
}

model Exam {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      ExamStatus @default(DRAFT)
  
  // Academic Linking
  courseId    String?
  departmentId String?

  // Exam settings
  timeLimitMin Int?      // null = untimed
  shuffleQuestions Boolean @default(false)
  shuffleOptions   Boolean @default(false)
  passMarkPct     Int     @default(50)
  adaptive        Boolean @default(false) // CAT mode (Phase 4)
  maxAttempts     Int     @default(1)
  authorId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author      User           @relation("ExamAuthor", fields: [authorId], references: [id])
  items       ExamQuestion[]
  attempts    Attempt[]
  course      Course?        @relation(fields: [courseId], references: [id])
  department  Department?    @relation(fields: [departmentId], references: [id])

  @@index([authorId])
  @@index([courseId])
  @@index([departmentId])

  @@map("exam")
}

model ExamQuestion {
  id         String @id @default(cuid())
  examId     String
  questionId String
  order      Int
  points     Int    @default(1)

  exam     Exam     @relation(fields: [examId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
  @@index([questionId])

  @@map("exam_question")
}

model Attempt {
  id         String        @id @default(cuid())
  examId     String
  userId     String
  status     AttemptStatus @default(IN_PROGRESS)
  score      Int?          // raw score
  maxScore   Int?
  startedAt  DateTime      @default(now())
  submittedAt DateTime?
  // JSON snapshot of the exam as taken (question order, shuffled options)
  snapshot   Json?

  exam    Exam            @relation(fields: [examId], references: [id])
  user    User            @relation(fields: [userId], references: [id])
  answers AttemptAnswer[]

  @@unique([examId, userId, startedAt])
  @@index([userId])
  @@index([examId])

  @@map("attempt")
}

model AttemptAnswer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String
  // JSON payload: the student's response
  response   Json
  isCorrect  Boolean?
  pointsEarned Int?
  gradedAt   DateTime?

  attempt  Attempt  @relation(fields: [attemptId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])

  @@map("attempt_answer")
}

model Department {
  id    String @id @default(cuid())
  name  String @unique
  code  String @unique // e.g., CS, ME, EE
  
  users User[]
  exams Exam[]
  courses Course[]

  @@map("department")
}

model Course {
  id           String @id @default(cuid())
  code         String @unique // e.g., CS101
  title        String
  credits      Int    @default(3)
  departmentId  String?
  
  department   Department? @relation(fields: [departmentId], references: [id])
  exams        Exam[]
  enrollments  Enrollment[]

  @@index([departmentId])
  @@map("course")
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  role      EnrollmentRole @default(STUDENT) // STUDENT or INSTRUCTOR
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollment")
}

enum EnrollmentRole {
  STUDENT
  INSTRUCTOR
}
