# Database (docker compose `db` service, or a native Postgres)
DATABASE_URL="postgresql://cibiti:cibiti@localhost:5432/cibiti?schema=public"

# Auth.js — generate with: openssl rand -hex 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# Redis (job queue and server-side auto-submit)
REDIS_URL="redis://localhost:6379"

# Object storage (Garage, S3-compatible). Keys are created on first start of the `storage` service.
# Access key: "GK" + 24 hex chars (openssl rand -hex 12). Secret: 64 hex chars (openssl rand -hex 32).
STORAGE_ENDPOINT="http://localhost:3900"
STORAGE_REGION="garage"
STORAGE_BUCKET="cibiti"
STORAGE_ACCESS_KEY="GK000000000000000000000000"
STORAGE_SECRET_KEY="change-me"
GARAGE_RPC_SECRET="change-me"
GARAGE_ADMIN_TOKEN="change-me"
